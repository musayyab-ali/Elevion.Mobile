# Copy to .env (never commit it). EXPO_PUBLIC_* values are compiled into the app: settings, not secrets.
# For EAS builds set the same names in the build profile's "env" (eas.json) or as EAS environment variables.

# TheLink API, version 1 and 2. Use https:// as soon as the API server has a certificate:
# the app then also stops allowing plain-http traffic (see app.config.js).
EXPO_PUBLIC_API_URL=http://localhost:5241/api/v1
EXPO_PUBLIC_API_URL_TWO=http://localhost:5241/api/v2

# Value of the "api-security-key" header the API expects (an identifier for the API, not a secret).
EXPO_PUBLIC_API_KEY=replace-with-your-api-security-key
