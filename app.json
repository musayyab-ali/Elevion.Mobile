{
  "expo": {
    "name": "The Link",
    "slug": "The Link",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gemini-logo.png",
    "scheme": "myecommerceapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/gemini-logo.png",
        "backgroundImage": "./assets/images/gemini-logo.png",
        "monochromeImage": "./assets/images/gemini-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mr_babar7.TheLink"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/gemini-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/gemini-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7c12547-b022-4d64-b507-306770cc9974"
      }
    },
    "owner": "mr_babar7"
  }
}
